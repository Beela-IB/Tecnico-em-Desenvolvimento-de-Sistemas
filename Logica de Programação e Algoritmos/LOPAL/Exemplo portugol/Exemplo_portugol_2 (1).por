programa {
  funcao inicio() {
    real basemaior, basemenor, altura, area

    escreva ("Base Maior:")
    leia (basemaior)

    escreva ("Base menor:")
    leia (basemenor)

    escreva ("Altura:")
    leia (altura)
    
    area=((basemaior+basemenor)*altura)/2
    escreva("Área do trapézio:",area)
  }
}
